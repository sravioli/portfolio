---
import "../styles/app.css";
import "../nvim/nvim.css";
import { THEME_INIT_SCRIPT } from "../client/theme.ts";
import { siteUrl } from "../lib/routes.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f1f28" />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content="Simone Fidanza — .NET developer. Projects, dotfiles, and WezTerm plugins." />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={siteUrl("fonts/FiraCode-VF.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={siteUrl("fonts/SymbolsNerdFont-Subset.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="64x64" href={siteUrl("MF-DOOM.png")} />
  </head>
  <body>
    <slot />
  </body>
</html>
