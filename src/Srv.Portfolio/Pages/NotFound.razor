@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Not found | Simone's Portfolio</PageTitle>

<main class="not-found" aria-label="Page not found">
    <section class="not-found-content">
        <p class="not-found-location">
            <span class="prompt-user">guest@@portfolio</span>
            <span class="prompt-path">~</span>
        </p>
        <p class="not-found-command">
            <span class="prompt-success" aria-label="Previous exit status 0">(0)</span>
            <span class="prompt-arrow" aria-hidden="true">→</span>
            <span>cd @RequestedPath</span>
        </p>
        <p class="not-found-output">bash: cd: @RequestedPath: No such file or directory</p>
        <p class="not-found-location">
            <span class="prompt-user">guest@@portfolio</span>
            <span class="prompt-path">~</span>
        </p>
        <p class="not-found-return">
            <span class="not-found-exit" aria-label="Page not found: HTTP 404">(404)</span>
            <span class="prompt-arrow" aria-hidden="true">→</span>
            <a href="@Navigation.BaseUri" aria-label="nvim . — open the portfolio">nvim .</a>
        </p>
    </section>
</main>

@code {
    private string RequestedPath => $"./{Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]}";
}
