<pre class="raw-readme" data-repository="@Repository">@foreach (var line in Lines){<span class="raw-line">@line</span>}</pre>

@code {
    private bool _changed = true;

    // The parent assigns a new lines array whenever the document or view changes, so reference equality
    // detects real changes without re-diffing every raw line on each statusline update of the parent.
    [Parameter, EditorRequired] public IReadOnlyList<string> Lines { get; set; } = [];
    [Parameter] public string? Repository { get; set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        var lines = Lines;
        var repository = Repository;
        parameters.SetParameterProperties(this);
        _changed = !ReferenceEquals(lines, Lines) || !string.Equals(repository, Repository, StringComparison.Ordinal);
        return base.SetParametersAsync(ParameterView.Empty);
    }

    protected override bool ShouldRender() => _changed;
}
