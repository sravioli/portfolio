<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Srv.Portfolio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Srv.Portfolio.Content\Srv.Portfolio.Content.csproj" />
    <ProjectReference Include="..\Srv.Portfolio.Rendering\Srv.Portfolio.Rendering.csproj" />
    <ProjectReference Include="..\Srv.Portfolio.ContentGenerator\Srv.Portfolio.ContentGenerator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.12"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="Srv.Portfolio.Rendering.wasm;AngleSharp.wasm;AngleSharp.Css.wasm;HtmlSanitizer.wasm;Markdig.wasm;System.Text.Encoding.CodePages.wasm" />
    <Compile Include="$(IntermediateOutputPath)RootReadme.g.cs" />
  </ItemGroup>

  <Target Name="GenerateRootReadme" BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../Srv.Portfolio.ContentGenerator/bin/$(Configuration)/net10.0/Srv.Portfolio.ContentGenerator.dll&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)RootReadme.g.cs&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)RootReadme.g.cs" />
    </ItemGroup>
  </Target>
</Project>
