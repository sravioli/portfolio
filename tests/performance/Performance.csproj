<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Srv.Portfolio.Tests</AssemblyName>
    <PortfolioSourceRoot Condition="'$(PortfolioSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\src</PortfolioSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PortfolioSourceRoot)\Srv.Portfolio\Services\NavigationState.cs" Link="NavigationState.cs" />
    <Compile Include="$(PortfolioSourceRoot)\Srv.Portfolio\Services\FileSearch.cs" Link="FileSearch.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\Srv.Portfolio.Content\Models\ReadmeSnapshot.cs"
             Link="ReadmeSnapshot.cs"
             Condition="!Exists('$(PortfolioSourceRoot)\Srv.Portfolio.Content\Models\ReadmeSnapshot.cs')" />
    <ProjectReference Include="$(PortfolioSourceRoot)\Srv.Portfolio.Rendering\Srv.Portfolio.Rendering.csproj" />
  </ItemGroup>
</Project>
